{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:customer-fabric:profile.updated.v1",
  "title": "profile.updated.v1 internal outbox payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile_id",
    "version",
    "mutation_id",
    "source"
  ],
  "properties": {
    "profile_id": {
      "type": "string",
      "format": "uuid"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "mutation_id": {
      "type": "string",
      "format": "uuid"
    },
    "source": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    }
  }
}
