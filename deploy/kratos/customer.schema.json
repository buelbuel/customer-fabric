{
  "$id": "https://customer-fabric.example.test/kratos/customer.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "traits": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "ory.sh/kratos": {
            "credentials": {"password": {"identifier": true}},
            "verification": {"via": "email"}
          }
        }
      },
      "required": ["email"],
      "additionalProperties": false
    }
  },
  "required": ["traits"],
  "additionalProperties": false
}
